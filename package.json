{
  "name": "indexes-store-native",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "test": "node --test tests/*.test.mjs",
    "check:syntax": "node scripts/check-syntax.cjs",
    "verify": "npm run test && npm run check:syntax",
    "prebuild": "expo prebuild --platform android --no-install",
    "build:android:evaluation": "cd android && ./gradlew :app:assembleRelease"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.73.6",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "expo-crypto": "~12.8.1",
    "expo": "^50.0.0",
    "expo-splash-screen": "~0.26.4",
    "expo-av": "~13.10.6",
    "@expo/vector-icons": "^14.0.0",
    "expo-font": "~11.10.3"
  },
  "devDependencies": {
    "@babel/parser": "^7.26.0",
    "babel-preset-expo": "~9.3.0"
  },
  "main": "index.js"
}
