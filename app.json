{
  "expo": {
    "name": "Indexes Store",
    "slug": "indexes-store",
    "scheme": "indexesstore",
    "version": "0.2.2",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.indexesstore.mobile",
      "versionCode": 5,
      "permissions": [
        "INTERNET"
      ],
      "splash": {
        "backgroundColor": "#FFFFFF",
        "resizeMode": "contain"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/indexes-app-512-maskable.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "ios": {
      "bundleIdentifier": "com.indexesstore.mobile"
    },
    "extra": {
      "buildPurpose": "evaluation-debug",
      "sourceRepo": "helalalfqih-sketch/my_Store2",
      "sourceThemeId": "162512797781",
      "sourceThemeName": "Indexes — Homepage Video Banners — Draft"
    },
    "splash": {
      "backgroundColor": "#FFFFFF",
      "resizeMode": "contain"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "resizeMode": "contain"
        }
      ]
    ],
    "icon": "./assets/indexes-app-512.png"
  }
}
